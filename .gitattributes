# Chuẩn hoá kết thúc dòng khi vào kho mã, để không phụ thuộc cấu hình autocrlf của từng máy.

* text=auto

*.cs        text eol=crlf
*.csproj    text eol=crlf
*.slnx      text eol=crlf
*.props     text eol=crlf
*.ps1       text eol=crlf
*.html      text eol=crlf
*.css       text eol=crlf
*.js        text eol=crlf
*.json      text eol=crlf
*.md        text eol=crlf
*.yml       text eol=crlf

# Ảnh và tệp nhị phân: đừng đụng tới
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.exe       binary
*.dll       binary
