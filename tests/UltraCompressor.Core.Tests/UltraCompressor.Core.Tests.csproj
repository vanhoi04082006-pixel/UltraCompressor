<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!--
      Tên hàm kiểm thử dùng gạch dưới thay cho dấu tiếng Việt: Doc_thoi_luong, Hoan_tac,
      v.v. Việc bỏ gạch dưới sẽ ép phải dùng ký tự không dấu, làm tên khó đọc hơn nhiều
      với người đọc tiếng Việt.
    -->
    <NoWarn>CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UltraCompressor.Core\UltraCompressor.Core.csproj" />
  </ItemGroup>

</Project>