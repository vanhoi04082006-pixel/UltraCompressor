<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!--
      Tên hàm kiểm thử dùng gạch dưới thay cho dấu tiếng Việt: Doc_thoi_luong, Hoan_tac,
      v.v. Việc bỏ gạch dưới sẽ ép phải dùng ký tự không dấu, làm tên khó đọc hơn nhiều
      với người đọc tiếng Việt.
    -->
    <NoWarn>CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!--
    Bắt buộc mới có tác dụng: không có mục này thì tệp json chỉ nằm trong thư mục dự án và
    runner không bao giờ đọc tới.

    Vì sao tắt song song: các test `[RequiresFFmpeg]` chạy encode thật ở 720p/1080p, mà xUnit
    mặc định cho MỖI LỚP test chạy song song — tức nhiều encode cùng tranh toàn bộ CPU. Trong khi
    đó `QualityProbe.PerWindowTimeout` (240s) và `ReferenceWindowExtractor.PerWindowTimeout`
    (180s) đều là thời gian thực. Khi máy tranh chấp, thời hạn bị vượt, và đường đo trả null
    vì "không đo được" — test đỏ với lý do là tốc độ, không phải lỗi sản phẩm.
  -->
  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UltraCompressor.Core\UltraCompressor.Core.csproj" />
  </ItemGroup>

</Project>